<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.creator.CreatorMapper">

    <select id="existsById" resultType="boolean">
        SELECT COUNT(*) > 0 FROM creators WHERE id = #{id}
    </select>

    <insert id="insert">
        INSERT INTO creators (id, name) VALUES (#{id}, #{name})
    </insert>

    <select id="findAll" resultType="com.example.creator.Creator">
        SELECT id, name FROM creators
    </select>

    <select id="findById" resultType="com.example.creator.Creator">
        SELECT id, name FROM creators WHERE id = #{id}
    </select>

    <delete id="deleteById">
        DELETE FROM creators WHERE id = #{id}
    </delete>
</mapper>